# Audio HAL
allow hal_audio_default audio_socket:sock_file rw_file_perms;
allow hal_audio_default audio_socket:dir rw_dir_perms;

# Allow audio HAL to access audio data
allow hal_audio_default audio_data_file:dir rw_dir_perms;
allow hal_audio_default audio_data_file:file create_file_perms;

# Allow audio HAL to access persist
allow hal_audio_default mnt_vendor_file:dir search;
allow hal_audio_default persist_audio_file:dir rw_dir_perms;
allow hal_audio_default persist_audio_file:file create_file_perms;

# Allow audio HAL to access audio devices
allow hal_audio_default sound_device:chr_file rw_file_perms;
allow hal_audio_default sound_device:dir r_dir_perms;

# Allow audio HAL to use vendor properties
get_prop(hal_audio_default, vendor_audio_prop)
