# Vendor init
allow vendor_init persist_block_device:lnk_file relabelto;

# Allow vendor_init to set vendor properties
set_prop(vendor_init, vendor_default_prop)
set_prop(vendor_init, vendor_audio_prop)
set_prop(vendor_init, vendor_camera_prop)
set_prop(vendor_init, vendor_display_prop)
set_prop(vendor_init, vendor_usb_prop)
set_prop(vendor_init, vendor_wifi_prop)
set_prop(vendor_init, vendor_bluetooth_prop)

# Allow vendor_init to mount
allow vendor_init labeledfs:filesystem remount;

# Allow vendor_init to write to sysfs
allow vendor_init sysfs:file w_file_perms;
allow vendor_init sysfs_leds:file w_file_perms;
allow vendor_init sysfs_batteryinfo:file w_file_perms;
allow vendor_init sysfs_graphics:file w_file_perms;

# Allow vendor_init to create directories
allow vendor_init mnt_vendor_file:dir create_dir_perms;
allow vendor_init persist_file:dir create_dir_perms;
