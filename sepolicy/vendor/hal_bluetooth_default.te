# Bluetooth HAL
allow hal_bluetooth_default bt_firmware_file:dir r_dir_perms;
allow hal_bluetooth_default bt_firmware_file:file r_file_perms;

# Allow bluetooth HAL to access persist
allow hal_bluetooth_default mnt_vendor_file:dir search;
allow hal_bluetooth_default persist_bluetooth_file:dir rw_dir_perms;
allow hal_bluetooth_default persist_bluetooth_file:file create_file_perms;

# Allow bluetooth HAL to use vendor properties
get_prop(hal_bluetooth_default, vendor_bluetooth_prop)
set_prop(hal_bluetooth_default, vendor_bluetooth_prop)
