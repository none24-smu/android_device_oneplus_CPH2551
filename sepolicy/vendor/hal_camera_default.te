# Camera HAL

# Allow camera to access camera data
allow hal_camera_default camera_data_file:dir create_dir_perms;
allow hal_camera_default camera_data_file:file create_file_perms;

# Allow camera to access persist
allow hal_camera_default mnt_vendor_file:dir search;
allow hal_camera_default persist_camera_file:dir rw_dir_perms;
allow hal_camera_default persist_camera_file:file create_file_perms;

# Allow camera to access video devices
allow hal_camera_default video_device:chr_file rw_file_perms;
allow hal_camera_default video_device:dir r_dir_perms;

# Allow camera to access graphics device
allow hal_camera_default gpu_device:chr_file rw_file_perms;

# Allow camera to use ion
allow hal_camera_default ion_device:chr_file r_file_perms;
allow hal_camera_default dmabuf_heap_device:chr_file r_file_perms;
