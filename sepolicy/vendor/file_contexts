# Data files
/data/vendor/fpc(/.*)?                                  u:object_r:fingerprint_vendor_data_file:s0
/data/vendor/goodix(/.*)?                               u:object_r:fingerprint_vendor_data_file:s0

# Devices
/dev/goodix_fp                                          u:object_r:fingerprint_device:s0
/dev/fpc_interrupt                                      u:object_r:fingerprint_device:s0
/dev/elliptic[0-9]                                      u:object_r:sound_device:s0

# Fingerprint
/(vendor|system/vendor)/bin/hw/android\.hardware\.biometrics\.fingerprint@2\.3-service\.oneplus    u:object_r:hal_fingerprint_default_exec:s0

# Firmware
/firmware(/.*)?                                         u:object_r:firmware_file:s0
/bt_firmware(/.*)?                                      u:object_r:bt_firmware_file:s0

# HALs
/(vendor|system/vendor)/bin/hw/android\.hardware\.light-service\.oneplus       u:object_r:hal_light_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.power-service\.oneplus       u:object_r:hal_power_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.lineage\.livedisplay@2\.1-service\.oneplus   u:object_r:hal_lineage_livedisplay_qti_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.oneplus\.hardware\.display@1\.0-service        u:object_r:hal_graphics_composer_default_exec:s0

# Modules
/vendor/lib/modules(/.*)?                               u:object_r:vendor_kernel_modules:s0

# NFC
/(vendor|system/vendor)/bin/hw/android\.hardware\.nfc@1\.2-service\.st           u:object_r:hal_nfc_default_exec:s0

# OnePlus-specific
/op1(/.*)?                                              u:object_r:op1_file:s0
/op2(/.*)?                                              u:object_r:op2_file:s0

# Partitions
/dev/block/platform/soc/1d84000\.ufshc/by-name/persist       u:object_r:persist_block_device:s0
/dev/block/platform/soc/1d84000\.ufshc/by-name/metadata      u:object_r:metadata_block_device:s0

# Sensors
/(vendor|system/vendor)/bin/hw/android\.hardware\.sensors@2\.1-service\.oneplus        u:object_r:hal_sensors_default_exec:s0

