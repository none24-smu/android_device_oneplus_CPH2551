/(vendor|system/vendor)/bin/hw/android\.hardware\.usb@1\.3-service\.oneplus      u:object_r:hal_usb_default_exec:s0

# Vibrator
/(vendor|system/vendor)/bin/hw/vendor\.qti\.hardware\.vibrator\.service\.oneplus        u:object_r:hal_vibrator_default_exec:s0

# WiFi
/(vendor|system/vendor)/bin/hw/android\.hardware\.wifi@1\.0-service        u:object_r:hal_wifi_default_exec:s0