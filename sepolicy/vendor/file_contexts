/sys/class/drm/card0/device/panel_serial_number         u:object_r:vendor_sysfs_graphics:s0
/sys/class/leds(/.*)?                                   u:object_r:sysfs_leds:s0
/sys/class/power_supply(/.*)?                           u:object_r:sysfs_batteryinfo:s0
/sys/devices/platform/soc/[0-9a-f]+\.i2c/i2c-[0-9]+/[0-9]+-[0-9a-f]+/power_supply/battery(/.*)?     u:object_r:sysfs_batteryinfo:s0
