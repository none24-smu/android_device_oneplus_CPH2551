on init
    mkdir /system_root
    mkdir /system_ext_root
    mkdir /vendor_root
    mkdir /product_root
    mkdir /odm_root

on fs
    wait /dev/block/platform/soc/1d84000.ufshc
    symlink /dev/block/platform/soc/1d84000.ufshc /dev/block/bootdevice

on boot
    # Set permissions for firmware
    chmod 0664 /sys/class/backlight/panel0-backlight/brightness
    chown system system /sys/class/backlight/panel0-backlight/brightness

    # Disable thermal zone
    write /sys/class/thermal/thermal_zone0/mode disabled
    write /sys/class/thermal/thermal_zone1/mode disabled

service vendor.qseecomd /vendor/bin/qseecomd
    class core
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service-qti
    class hal
    user system
    group system
    disabled
    seclabel u:r:recovery:s0

service vendor.keymaster-4-1 /vendor/bin/hw/android.hardware.keymaster@4.1-service-qti
    class hal
    user system
    group system
    disabled
    seclabel u:r:recovery:s0
